name = "resumatch-gateway"
main = "worker.js"
compatibility_date = "2026-06-02"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "replace_with_cloudflare_kv_namespace_id"

[vars]
AI_PROVIDER = "deepseek"
AI_MODEL = "deepseek-chat"
AI_API_BASE = "https://api.deepseek.com/chat/completions"
ALLOWED_ORIGINS = "https://your-official-domain.com"
TURNSTILE_REQUIRED = "false"
PER_IP_DAILY_LIMIT = "40"
DAILY_COST_LIMIT_CNY = "1"

# Configure secret separately:
# wrangler secret put AI_API_KEY
# wrangler secret put TURNSTILE_SECRET_KEY
# wrangler secret put ADMIN_BYPASS_TOKEN
